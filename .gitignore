.DS_Store
Thumbs.db

# Local secrets
.env
.env.*
!.env.example
*.pem
*.rpem
*.key

# Python-generated files
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
venv/

# Editor / local tooling
.vscode/
.idea/
.graphify_scope/
graphify-out/

# Local scratch / temp outputs
.backfill_cursor
.tmp/
tmp/
tmp_*/
scratchpad/
fig/
catboost_info/
tmp_*.txt
*.tgz

# Large local data and runtime logs
data/
!src/live/data/
!src/live/data/**
src/live/data/**/__pycache__/
src/live/data/**/*.py[oc]
data.zip
output/
*.tar.zst

# Keep only the bagged-lasso deploy artifact needed by the dedicated live runner.
# All other training / evaluation artifacts stay local.
artifacts/*
!artifacts/kalshi/
artifacts/kalshi/*
!artifacts/kalshi/kxbtc15m_bagged_lasso/
artifacts/kalshi/kxbtc15m_bagged_lasso/*
!artifacts/kalshi/kxbtc15m_bagged_lasso/latest/
!artifacts/kalshi/kxbtc15m_bagged_lasso/latest/**

# Research writeups
research/*
!research/main.tex
!research/main.pdf
!research/fig/
!research/analysis/
!research/sections/
